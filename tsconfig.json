{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@varejopro/types": ["packages/types/src/index.ts"],
      "@varejopro/permissions": ["packages/permissions/src/index.ts"],
      "@varejopro/domain": ["packages/domain/src/index.ts"],
      "@varejopro/auth": ["packages/auth/src/index.ts"],
      "@varejopro/offline": ["packages/offline/src/index.ts"],
      "@varejopro/sync": ["packages/sync/src/index.ts"],
      "@varejopro/api-client": ["packages/api-client/src/index.ts"],
      "@varejopro/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "server", "server.ts", "server/**/*.ts", "packages/**/*.ts", "packages/**/*.tsx", "apps/**/*.ts", "apps/**/*.tsx"]
}
